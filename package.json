{
  "name": "@bornfly/fe-cfl-shell",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Package-consumer shell for independent frontend CFL repositories.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && vite build",
    "verify:boundary": "node scripts/verify-package-boundary.mjs",
    "verify:migration": "npm run verify:boundary",
    "test": "node --import tsx --test $(find scripts -name '*.test.ts' -o -name '*.test.tsx')",
    "ci": "npm run verify:boundary && npm run typecheck && npm run test && npm run build",
    "review:prd": "npm run verify:boundary"
  },
  "dependencies": {
    "@bornfly-detachment/fe-canvas-relation-cfl": "git+https://github.com/bornfly-detachment/fe-canvas-relation-cfl.git#3bf679d1668b4528bcd9942e941b9fd5e3df8919",
    "@bornfly-detachment/fe-cli-bridge-cfl": "git+https://github.com/bornfly-detachment/fe-cli-bridge-cfl.git#becdfc79ae7e2859dbc413a0e0daab791c94a219",
    "@bornfly-detachment/fe-control-plane-cfl": "git+https://github.com/bornfly-detachment/fe-control-plane-cfl.git#9705f3677a173611899299a47b0a2491c747e68c",
    "@bornfly-detachment/fe-login-cfl": "git+https://github.com/bornfly-detachment/fe-login-cfl.git#243ba941293bef8b13ae8da4fbc32d9cfcd46cb9",
    "@bornfly-detachment/fe-memory-chronicle-cfl": "git+https://github.com/bornfly-detachment/fe-memory-chronicle-cfl.git#a1e86d2c938574ce18c823f0cc4cfff7426d1247",
    "@bornfly-detachment/fe-obsidian-cfl": "git+https://github.com/bornfly-detachment/fe-obsidian-cfl.git#2b45a31dceec953ae80240cf754ab432cbe9a624",
    "@bornfly-detachment/fe-protocol-builder-cfl": "git+https://github.com/bornfly-detachment/fe-protocol-builder-cfl.git#c34f4d542d608a63b1fc47b9e230a056fc892296",
    "@bornfly-detachment/fe-prvse-world-cfl": "git+https://github.com/bornfly-detachment/fe-prvse-world-cfl.git#d030ceae97b423f0a59c3a49b212c879eaa0f2f0",
    "@bornfly-detachment/fe-resource-intelligence-cfl": "git+https://github.com/bornfly-detachment/fe-resource-intelligence-cfl.git#34bc9eb9812eeaf2efb65e79daad017615c024b0",
    "@bornfly-detachment/fe-rich-editor-cfl": "git+https://github.com/bornfly-detachment/fe-rich-editor-cfl.git#4c72ec7ca0195d3a20b773f98bd1a7308a9242fe",
    "@bornfly-detachment/fe-task-lifecycle-cfl": "git+https://github.com/bornfly-detachment/fe-task-lifecycle-cfl.git#b4c37b72a2ffc6fe5b4eeff59055ecd3b8675133",
    "@vitejs/plugin-react": "^6.0.2",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.13"
  },
